PORT=5000
NODE_ENV=development
# Comma-separated exact browser origins. Never use wildcard origins with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Neon / Cloud PostgreSQL Database URL
DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DATA_DIR=./data
