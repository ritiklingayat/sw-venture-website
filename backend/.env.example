PORT=8080
NODE_ENV=development
# Comma-separated exact browser origins. Never use wildcard origins with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Recommended for production: a dedicated least-privilege PostgreSQL database/user.
# DATABASE_URL=postgresql://swventure_app:change_me@localhost:5432/swventure
# Set true only when your provider requires TLS. Keep certificate verification enabled.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
# Used only when DATABASE_URL is not configured (local development fallback).
DATA_DIR=./data
